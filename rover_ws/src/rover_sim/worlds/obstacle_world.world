<?xml version="1.0"?>
<sdf version="1.6">
  <world name="obstacle_world">
    <!-- Light and ground -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Some box obstacles -->
    <model name="box1">
      <pose>3 0 0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.1</size></box></geometry>
          <material><ambient>1 0 0 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="box2">
      <pose>4 1 0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 0.3 0.1</size></box></geometry>
          <material><ambient>0 0 1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.3 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
  </world>
</sdf>
